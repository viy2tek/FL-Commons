{
  "openapi": "3.1.0",
  "info": {
    "title": "FL Commons API",
    "version": "0.1.0",
    "description": "Independent community API. This contract describes the optional Core HTTP server; the native plugin exposes a documented subset. Only advertised operations are callable."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3210",
      "description": "Optional Core server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
