  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "connected",
          "mode",
          "fl_version"
        ],
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "mode": {
            "type": "string"
          },
          "fl_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "session_id": {
            "type": "string"
          },
          "gui_responsive": {
            "type": "boolean"
          }
        }
      },
      "Command": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "method",
              "params"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "const": "transport.state"
              },
              "params": {
                "type": "object",
                "maxProperties": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "method",
              "params"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "const": "transport.play_pause"
              },
              "params": {
                "type": "object",
                "maxProperties": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "method",
              "params"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "const": "transport.stop"
              },
              "params": {
                "type": "object",
                "maxProperties": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "method",
              "params"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "const": "transport.start"
              },
              "params": {
                "type": "object",
                "maxProperties": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "method",
              "params"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "const": "host.inspect"
              },
              "params": {
                "type": "object",
                "maxProperties": 0
              }
            }
          },
          {
            "type": "object",
            "required": [
              "method",
              "params"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "const": "sdk.catalog"
              },
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "domain": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
